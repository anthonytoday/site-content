---
layout: null
permalink: /sitemap.xml
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
        xmlns:xhtml="http://www.w3.org/1999/xhtml">
{%- assign pages = site.pages | where_exp: "p", "p.permalink" | sort: "permalink" -%}
{%- for p in pages -%}
{%- if p.permalink contains ".xml" or p.permalink contains ".txt" -%}{%- continue -%}{%- endif -%}
{%- if p.sitemap == false -%}{%- continue -%}{%- endif -%}
{%- if p.lang == "fr" -%}{%- assign en = p.alt_url -%}{%- assign fr = p.permalink -%}
{%- else -%}{%- assign en = p.permalink -%}{%- assign fr = p.alt_url -%}{%- endif -%}
  <url>
    <loc>{{ p.permalink | absolute_url }}</loc>
    <lastmod>{{ site.time | date: "%Y-%m-%d" }}</lastmod>
{%- if en and fr %}
    <xhtml:link rel="alternate" hreflang="en" href="{{ en | absolute_url }}"/>
    <xhtml:link rel="alternate" hreflang="fr" href="{{ fr | absolute_url }}"/>
    <xhtml:link rel="alternate" hreflang="x-default" href="{{ en | absolute_url }}"/>
{%- endif %}
    <changefreq>{% if p.permalink == "/" or p.permalink == "/fr/" %}weekly{% else %}monthly{% endif %}</changefreq>
    <priority>{% if p.permalink == "/" %}1.0{% elsif p.permalink == "/notion-build/" or p.permalink == "/notion-for-real-estate/" %}0.9{% elsif p.permalink == "/fr/" %}0.9{% elsif p.lang == "fr" %}0.7{% else %}0.8{% endif %}</priority>
  </url>
{%- endfor %}
</urlset>
